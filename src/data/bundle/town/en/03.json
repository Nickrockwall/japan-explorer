":[["盛岡市",0,0],["玉山村",0,2006]],"03202":[["宮古市",0,0],["新里村",0,2005],["田老町",0,2005],["川井村",0,2010]],"03203":[["大船渡市",0,0],["三陸町",0,2001]],"03205":[["花巻市",0,0],["大迫町",0,2006],["東和町",0,2006],["石鳥谷町",0,2006]],"03207":[["久慈市",0,0],["山形村",0,2006]],"03208":[["遠野市",0,0],["宮守村",0,2005]],"03209":[["一関市",0,0],["千厩町",0,2005],["大東町",0,2005],["室根村",0,2005],["川崎村",0,2005],["東山町",0,2005],["花泉町",0,2005],["藤沢町",0,2011]],"03213":[["二戸市",0,0],["浄法寺町",0,2006]],"03214":[["安代町",0,2002],["松尾村",0,2005],["西根町",0,2005]],"03215":[["前沢町",0,2006],["水沢市",0,2006],["江刺市",0,2006],["胆沢町",0,2006],["衣川村",0,2006]],"03216":[["滝沢村",0,2014]],"03366":[["沢内村",0,2005],["湯田町",0,2005]],"03507":[["大野村",0,2006],["種市町",0,2006]]},"yurai":{"3":{"盛岡市":"Anciently Kozukata; first Morigaoka, then 森岡, \"wooded hill\", until the Nanbu lords wrote it 盛岡, \"a hill that rises and prospers\". Another view derives it simply from the wooded hill.","宮古市":"Several theories; most often traced to miyako, \"capital\", as the economic and cultural centre of the Hei district. Others read it as \"place of a shrine\" or \"deep-mountain dwelling\".","大船渡市":"\"The great landing place for boats.\"","花巻市":"Called Toriyagasaki in the Middle Ages. Theories include a famed horse pasture, \"the flower ranch\"; spring petals floating on the Kitakami River; and the Ainu pana, \"land opening downstream\".","北上市":"Thought to derive from the ancient name Hitakami. The present city was named in 1954, when Kurosawajiri and six other towns and villages merged.","久慈市":"Found as a district name from the 14th century. Theories: a \"pinched\" landform, a coast eaten away by the sea, or kutsu, a landing at the river mouth.","遠野市":"Either the plain of \"far Hei\", beyond the Hei district, or simply a distant plain among the mountains; an Ainu origin, to-nup (\"lake-plain\"), is also proposed.","一関市":"From ichi-no-seki, the first weir built against Kitakami River floods; another view links it to the barriers of Hiraizumi, as the city has an Ichinoseki, Ninoseki and Sannoseki.","陸前高田市":"Rikuzen is the old province name; Takata is said to come from the sacred rice fields of Mount Hikami. In the 1955 merger the name of the central town, Takata, was given the prefix Rikuzen.","釜石市":"Theories include stone for making iron pots (kama), Ainu words for \"where fish are dried\" or \"where there is a flat rock\", and pot-shaped stones.","二戸市":"From the Heian-era \"nine gates\" (kunohe) system of Nukanobu district, where the gates of the stockade were numbered one to nine, each with a horse pasture. The city took the name in 1972."}},"kyu":{"03201":{"t":59,"k":34773,"r":[["Morioka Domain",34773]]},"03202":{"t":47,"k":8733,"r":[["Morioka Domain",6951],["Sendai Domain",1782]]},"03203":{"t":10,"k":5604,"r":[["Sendai Domain",5604]]},"03205":{"t":100,"k":68325,"r":[["Morioka Domain",68325]]},"03206":{"t":36,"k":40169,"r":[["Morioka Domain",32211],["Sendai Domain",7958]]},"03207":{"t":28,"k":3872,"r":[["Hachinohe Domain",3594],["Morioka Domain",277],["@other",1]]},"03208":{"t":43,"k":14767,"r":[["Morioka Domain",14767]]},"03209":{"t":78,"k":75861,"r":[["Sendai Domain",44529],["@bakufu",21832],["Ichinoseki Domain",9500]]},"03210":{"t":10,"k":7164,"r":[["Sendai Domain",7164]]},"03211":{"t":10,"k":1291,"r":[["Morioka Domain",914],["Sendai Domain",377]]},"03213":{"t":42,"k":8991,"r":[["Morioka Domain",8093],["斗南藩",898]]},"03214":{"t":20,"k":8813,"r":[["Morioka Domain",8813]]},"03215":{"t":68,"k":93824,"r":[["Sendai Domain",93824]]},"03216":{"t":5,"k":3783,"r":[["Morioka Domain",3783]]},"03301":{"t":10,"k":10665,"r":[["Morioka Domain",10665]]},"03302":{"t":4,"k":1483,"r":[["Hachinohe Domain",1168],["Morioka Domain",315]]},"03303":{"t":15,"k":2909,"r":[["Morioka Domain",2909]]},"03321":{"t":38,"k":25934,"r":[["Morioka Domain",19116],["Hachinohe Domain",6818]]},"03322":{"t":21,"k":15440,"r":[["Morioka Domain",15440]]},"03366":{"t":7,"k":4324,"r":[["Morioka Domain",4324]]},"03381":{"t":5,"k":12362,"r":[["Sendai Domain",12362]]},"03402":{"t":6,"k