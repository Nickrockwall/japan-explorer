89]],"13209":[["堺村",0,1889],["忠生村",0,1889],["鶴川村",0,1889],["南村",0,1889]],"13210":[["小金井村",0,1889]],"13211":[["小平村",0,1889]],"13212":[["日野町",0,1893],["七生村",0,1889]],"13213":[["東村山村",0,1889]],"13214":[["国分寺村",0,1889]],"13215":[["谷保村",0,1889]],"13218":[["福生村",0,1889],["熊川村",0,1889]],"13219":[["狛江村",0,1889]],"13221":[["清瀬村",0,1889]],"13222":[["久留米村",0,1889]],"13224":[["多摩村",0,1889]],"13225":[["稲城村",0,1889]],"13227":[["西多摩村",0,1889]],"13228":[["小宮村",0,1889],["五日市町",0,1889],["菅生村",0,1889],["草花村",0,1889],["増戸村",0,1889],["戸倉村",0,1889],["瀬戸岡村",0,1889],["原小宮村",0,1889],["東秋留村",0,1889],["西秋留村",0,1889]],"13229":[["保谷村",0,1889],["田無町",0,1889]],"13303":[["箱根ケ崎村",0,1889],["長岡村",0,1889],["石畑村",0,1889],["殿ケ谷村",0,1889]],"13305":[["大久野村",0,1889],["平井村",0,1889]],"13307":[["檜原村",0,1889]],"13308":[["氷川村",0,1889],["古里村",0,1889],["小河内村",0,1889]],"13361":[["岡田村",0,1908],["元村",0,1908],["泉津村",0,1908],["野増村",0,1908],["差木地村",0,1908],["波浮港村",0,1908]],"13401":[["三根村",0,1908],["大賀郷村",0,1908],["末吉村",0,1908],["樫立村",0,1908],["中之郷村",0,1908]]},"heisei":{"13229":[["保谷市",0,2001],["田無市",0,2001]]},"yurai":{"13":{"新宿区":"1698年に甲州街道の新しい宿場として、高遠藩内藤家の下屋敷に開かれた「内藤新宿」に由来する。","江東区":"隅田川の東に位置することから、「辰巳区」「東区」「永代区」などの候補から選ばれた。","大田区":"1947年に合併した大森区と蒲田区から1文字ずつ取った合成地名。","杉並区":"江戸時代初期、成宗・田端両村の領主が青梅街道沿いに植えた杉並木から。","板橋区":"旧中山道が石神井川を渡る「板橋」という橋に由来するとされる。","練馬区":"練馬城から、赤土を練った「ねり場」から、奈良時代の駅家「乗潴」の転訛など諸説ある。","足立区":"大化の改新後に定められた「武蔵国足立郡」に由来する。","葛飾区":"葛飾はもと下総国葛飾郡一帯の総称で『万葉集』にも見える。現在の区域は近世まで「葛西」と呼ばれた。","江戸川区":"区の東を流れる江戸川にちなむ。当初は区役所予定地の「松江区」が検討された。","八王子市":"八王子神社（八王子権現）と、その名をとった八王子城に由来する。","町田市":"「町」は田の区画、市が盛んだった（マチ＝イチ）、市神を祀る「祭り田」など諸説ある。","北区":"王子区と滝野川区の合併で「城北区」「飛鳥山区」「赤羽区」などが候補になり、「飛鳥山区」の支持が大きかったが読みにくいとされ、平易な方角名の「北区」に落ち着いた。","豊島区":"北豊島郡の4町が東京市に編入される際、郡名から採られた（さかのぼれば古代の武蔵国豊島郡）。東京市の原案は「池袋区」、次いで「目白区」で、陳情を受けて「豊島区」に決まった。","墨田区":"隅田川の堤の通称「墨堤」の「墨」と隅田川の「田」を採った。当時は「隅田区」を推す声が最多だったが、「隅」が当用漢字になかったため実現しなかった。","府中市":"律令時代に武蔵国の国府が置かれたことに由来する。","港区":"「愛宕区」「青山区」などの案から「城南区」と「東港区」に絞られた。東京港を抱えることから「東港区」が候補になったが、「東京都東港区」では音が重なるため「東」を除いて「港区」とした。","調布市":"昔の税である租庸調の「調」（土地の特産物を納める）として布を納めていたことに由来する。","文京区":"小石川区と本郷区の合併でつけられた瑞祥地名。簡潔で書きやすく、「文教の府」という区のイメージに合うとして採用された。「京北区」「春日区」「湯島区」などの案もあった。","荒川区":"河川名の「荒川」から。1965年に河川法で荒川放水路が荒川本流となり、区内の旧本流は隅田川となったため区内を荒川は流れていないが、区名は変わっていない。東京市の原案は区役所予定地の「三河島」だった。","台東区":"下谷区と浅草区の合併で名称が紛糾し、下谷側は「上野区」、浅草側は「東区」を推した。結局、都知事の案で下谷区台東小学校が使っていた「台東」を採った。上野の高台の「台」と、その東の下町の「東」を合わせたもの。","西東京市":"田無市と保谷市の合併で、公募から「西東京市」「けやき野市」「北多摩市」「ひばり市」「みどり野市」の5案に絞り、市民意向調査で最も支持の多かった「西東京市」に決めた。","小平市":"1889年の7村合併の際、中心だった小川村の「小」と、武蔵野台地上の平らな土地の「平」から名付けられたとされる。","日野市":"諸説ある。『武蔵名勝図会』は府中の国府の烽火台が置かれた「飛火野」説を採り、『新編武蔵風土記稿』は西党の祖日奉宗頼が日野宮権現を祀った伝説を載せる。","立川市":"2説ある。国府が府中にあった時代、「多摩の横山」から見て多摩川が縦に流れる辺りを「立の河」と呼び、それが「立川」になった説と、豪族立川氏が今の普済寺に城を築いたことによる説。","中央区":"東京市の地理的中央に位置し、経済文化の中心地であることから名付けられた。「中央」を正式に区名・地名とした日本初の例。「江戸区」「銀座区」「大江戸区」などの案もあった。","東村山市":"武蔵七党の村山党の由来でもある武蔵国村山（狭山丘陵南麓）の最東端にあたるため「東」を冠した。村山は狭山丘陵を「群山」と呼んだことによる。","青梅市":"諸説あるが、平将門が金剛寺で馬の鞭の梅枝を地に挿して願をかけると根付いて実を結び、夏を過ぎても実が青いまま落ちなかったという「将門誓いの梅」の伝説が広く知られる。","小金井市":"「はけ」の南側の金井原を「こがねいはら」と読んだ説と、はけに沿って黄金に値する湧水があり「黄金の井」と称した説がある。","東久留米市":"市の北部を流れる黒目川の旧称「久留米川」に由来するとされる。市制時にはすでに福岡県久留米市があり、混同を避けるとともに駅名で親しまれていた「東久留米市」とした。","狛江市":"かつての「狛江郷」による（郷名の由来には諸説ある）。市制施行時のアンケートでは73.5%が狛江の継続を望み、ひらがなの「こまえ市」にする案もあった。","あきる野市":"古来「秋留」「阿伎留」の地名があり、旧五日市町に阿伎留神社があることによる。秋川市側は「あきる野」か「阿伎留」、五日市町側は「秋川五日市市」を推したが、1995年の協議会で五日市町が譲歩した。","清瀬市":"市内の地名「清戸」と柳瀬川から一字ずつ取った説（「清戸」は日本武尊が木の下で休み「清き土なり」と言ったことからという）と、柳瀬川の「清らかなせせらぎ」から名付けた説がある。","国立市":"中央線の国分寺駅と立川駅の中間にできる新駅とこの地区に、両駅から1字ずつ取って「国立」と名付けた。「こくりつ」と誤読されやすいため、仮名書きされることもある。"}},"kyu":{"13101":{"t":1,"k":5,"r":[["@jisha",5]]},"13103":{"t":16,"k":2096,"r":[["@bakufu",2021],["@jisha",75]]},"13104":{"t":23,"k":3580,"r":[["@hatamoto",1300],["@bakufu",1225],["@jisha",1056]]},"13105":{"t":5,"k":369,"r":[["@jisha",232],["@bakufu",113],["@hatamoto",24]]},"13106":{"t":31,"k":2081,"r":[["@bakufu",1087],["@jisha",995]]},"13107":{"t":12,"k":3664,"r":[["@bakufu",3311],["@jisha",353]]},"13108":{"t":28,"k":6271,"r":[["@bakufu",5956],["一橋家領",244],["@jisha",72]]},"13109":{"t":13,"k":5466,"r":[["@bakufu