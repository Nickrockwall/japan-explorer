":[["盛岡市",0,0],["玉山村",0,2006]],"03202":[["宮古市",0,0],["新里村",0,2005],["田老町",0,2005],["川井村",0,2010]],"03203":[["大船渡市",0,0],["三陸町",0,2001]],"03205":[["花巻市",0,0],["大迫町",0,2006],["東和町",0,2006],["石鳥谷町",0,2006]],"03207":[["久慈市",0,0],["山形村",0,2006]],"03208":[["遠野市",0,0],["宮守村",0,2005]],"03209":[["一関市",0,0],["千厩町",0,2005],["大東町",0,2005],["室根村",0,2005],["川崎村",0,2005],["東山町",0,2005],["花泉町",0,2005],["藤沢町",0,2011]],"03213":[["二戸市",0,0],["浄法寺町",0,2006]],"03214":[["安代町",0,2002],["松尾村",0,2005],["西根町",0,2005]],"03215":[["前沢町",0,2006],["水沢市",0,2006],["江刺市",0,2006],["胆沢町",0,2006],["衣川村",0,2006]],"03216":[["滝沢村",0,2014]],"03366":[["沢内村",0,2005],["湯田町",0,2005]],"03507":[["大野村",0,2006],["種市町",0,2006]]},"yurai":{"3":{"盛岡市":"古くは「不来方」「古志方」、はじめは「森ヶ岡」、のちに「森岡」と呼ばれ、藩主南部氏が「盛り上がり、栄える岡」の意味を込めて「盛岡」と名付けた。杜の多い岡から転じたとする説もある。","宮古市":"諸説あり、閉伊地方の経済・文化の中心地という意味の「都」からとされる。神社のある所（宮処）、山中の在所「深山処」などの説もある。","大船渡市":"「大きな船着場」の意味。","花巻市":"中世は「鳥谷ヶ崎」と呼ばれた。名馬を産する牧場「花の牧」から、北上川に春の花びらが浮かぶ景色から、アイヌ語「パナ」（川下に開けた土地）からなど諸説ある。","北上市":"「日高見（ヒタカミ）」から変わったものとされる。昭和29（1954）年、黒沢尻町など7町村が合併して北上市と命名された。","久慈市":"南北朝期から郡名として見える。くびれた地形から、海食で崩れた所、河口の船着場「口津」など諸説ある。","遠野市":"閉伊の奥「遠閉伊」の野原、山間の遠い野という説のほか、アイヌ語のト（沼）ヌプ（野）からなど諸説ある。","一関市":"北上川の氾濫をせき止める一番目の堰「一ノ堰」から転じたとされる。市内に一関・二関・三関があり、平泉の関所にちなむという説もある。","陸前高田市":"「陸前」は旧国名。「高田」は気仙郡総鎮守の氷上山の神田を称したことからとされる。昭和30（1955）年の合併で、中心の高田町に陸前を冠して命名された。","釜石市":"釜をつくる石を多く産したことから、アイヌ語で魚を干す所・平岩のある所、釜に似た石など諸説ある。","二戸市":"平安時代、糠部郡の囲いの木戸に一から九の番号をふり一戸ごとに牧場を置いた「九戸四門」制に由来する。昭和47（1972）年の合併による市制施行で二戸市と命名された。"}},"kyu":{"03201":{"t":59,"k":34773,"r":[["盛岡藩",34773]]},"03202":{"t":47,"k":8733,"r":[["盛岡藩",6951],["仙台藩",1782]]},"03203":{"t":10,"k":5604,"r":[["仙台藩",5604]]},"03205":{"t":100,"k":68325,"r":[["盛岡藩",68325]]},"03206":{"t":36,"k":40169,"r":[["盛岡藩",32211],["仙台藩",7958]]},"03207":{"t":28,"k":3872,"r":[["八戸藩",3594],["盛岡藩",277],["@other",1]]},"03208":{"t":43,"k":14767,"r":[["盛岡藩",14767]]},"03209":{"t":78,"k":75861,"r":[["仙台藩",44529],["@bakufu",21832],["一関藩",9500]]},"03210":{"t":10,"k":7164,"r":[["仙台藩",7164]]},"03211":{"t":10,"k":1