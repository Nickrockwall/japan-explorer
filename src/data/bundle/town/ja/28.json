"佐用町",0,0],["三日月町",0,2005],["上月町",0,2005],["南光町",0,2005]],"28585":[["村岡町",0,2005],["美方町",0,2005],["香住町",0,2005]],"28586":[["浜坂町",0,2005],["温泉町",0,2005]]},"yurai":{"28":{"神戸市":"三宮・元町周辺に生田神社の神封戸の集落があったことに由来し、「かんべ」が音便化した。","姫路市":"姫路城のある姫山の古名「日女路の丘」に由来し、『播磨国風土記』にも見える。養蚕にちなむ説もある。","尼崎市":"漁業など海に関わる仕事の人々を表す「尼」に、地形を表す「崎」を合わせた地名で、もとは阪神大物駅以南の臨海部を指した。江戸後期の『守貞謾稿』にも「尼」と略す例が見える。","宝塚市":"「塚」は古墳のこと。宝塚と呼ばれた古墳には諸説あり場所は特定されていない。1672年の検地記録に「宝塚東」などの小字が見え、明治に温泉名・駅名となったのち、1951年に初めて市町村名になった。","伊丹市":"語源は諸説あり、太古の絲海（いとうみ）の入り江の地形による説、段丘の南北の板上に位置することによる説、川沿いの崩れやすい場所を意味する説などがある。","三田市":"金心寺の弥勒菩薩坐像の胎内に記された「三福田」（恩田・悲田・敬田）に由来するとされてきたが、新版『三田市史』の調査では確認できず、現在は伝承扱い。「三田村」の最古の記録は1477年の古文書。","三木市":"神功皇后が君が峰で休んだ時、地元から壷に入れた酒を献上したため、御酒（みき）→三木、美壷（みつぼ）→美嚢となったと伝えられる。"}},"kyu":{"28101":{"t":19,"k":4988,"r":[["兵庫県",3144],["尼崎藩",1844]]},"28102":{"t":20,"k":4432,"r":[["兵庫県",2702],["尼崎藩",1488],["@hatamoto",207],["古河藩",20],["@other",15]]},"28105":{"t":9,"k":5942,"r":[["兵庫県",5246],["@hatamoto",632],["@jisha",64]]},"28106":{"t":5,"k":2958,"r":[["@hatamoto",1106],["兵庫県",1000],["古河藩",853]]},"28107":{"t":10,"k":4727,"r":[["兵庫県",4322],["浅尾藩",377],["@jisha",28]]},"28108":{"t":10,"k":4028,"r":[["明石藩",3986],["@jisha",42]]},"28109":{"t":63,"k":24267,"r":[["明石藩",5459],["兵庫県",4764],["三田藩",3667],["田安家領",3609],["@other",6768]]},"28110":{"t":19,"k":4388,"r":[["兵庫県",4093],["尼崎藩",238],["古河藩",56],["@jisha",2]]},"28111":{"t":96,"k":31356,"r":[["明石藩",30942],["@jisha",239],["兵庫県",175]]},"28201":{"t":265,"k":129301,"r":[["姫路藩",99887],["龍野藩",9365],["丸亀藩",6482],["林田藩",3931],["@other",9636]]},"28202":{"t":64,"k":34232,"r":[["尼崎藩",21251],["@hatamoto",7919],["兵庫県",2350],["飯野藩",1631],["@other",1081]]},"28203":{"t":44,"k":26246,"r":[["明石藩",22223],["忍藩",3760],["@jisha",252],["@mixed",10],["@other",1]]},"28204":{"t":33,"k":16097,"r":[["兵庫県",6207],["尼崎藩",5333],["@hatamoto",2986],["田安家領",1069],["@other",502]]},"28205":{"t":69,"k":37285,"r":[["徳島藩",37285]]},"28206":{"t":4,"k":1920,"r":[["兵庫県",1611],["尼崎藩",309]]},"28207":{"t":42,"k":15949,"r":[["@hata