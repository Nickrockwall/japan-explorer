["三芳村",0,2006],["丸山町",0,2006],["千倉町",0,2006],["和田町",0,2006],["富山町",0,2006],["富浦町",0,2006],["白浜町",0,2006]],"12235":[["八日市場市",0,2006],["野栄町",0,2006]],"12236":[["佐原市",0,2006],["小見川町",0,2006],["山田町",0,2006],["栗源町",0,2006]],"12237":[["山武町",0,2006],["成東町",0,2006],["松尾町",0,2006],["蓮沼村",0,2006]],"12238":[["大原町",0,2005],["夷隅町",0,2005],["岬町",0,2005]],"12239":[["大網白里町",0,2013]],"12410":[["光町",0,2006],["横芝町",0,2006]]},"yurai":{"12":{"船橋市":"日本武尊が東征の折、海老川に船を並べ板を渡して橋にしたという伝説が最も有力な説。","松戸市":"馬の飼育が盛んな「馬里」から、ヤマトタケルが従者を待った「待つ里」から、渡し舟を待つ里から、など諸説。","流山市":"群馬県の赤城山の山体が崩れ、大きな欠片が利根川を下って流れ着いたという逸話に由来する。","浦安市":"初代村長新井甚佐衛門の「浦（海）やすかれ」という言葉と、心安らかにという願いからとされる。『日本書紀』神武紀に伊弉諾尊が日本を「浦安の国」と名付けたとあり、日本の古称・美称でもある。","野田市":"武将野田右馬助が館を構えたことに由来するという説が有力だが、野田の地名を取って名乗ったとする説もあり定かではない。","木更津市":"通説はヤマトタケル伝承の「君不去（きみさらず）」。「如月の津」説などもある。最古の表記は1353年の文献の「木佐良津」。","成田市":"雷がよく鳴る「鳴田」、稲がよく実る「熟田」、最近の研究では開墾してなりわいとした「業田」などの説がある。","四街道市":"四街道駅の西の「四街道十字路」に成田山道・千葉町道・東金道・東京船橋道を刻んだ道標があり、街道が四方に延びることから「四つ角」→「四ツ街道」→「四街道」となった。1881年に四つ角に開いた私設郵便局の初代局長福島和吉が局名を「四街道」とするよう県に願い出たのが始まりとされる。","茂原市":"774年に赴任した藤原黒麻呂が拓いた荘園「藻原荘」に由来する。湿地が多く「藻原」と書いたが、江戸時代に「茂原」と改まったという。","香取市":"「かとり」の語源は「梶取」「神鳥」「鹿取」など諸説ある。「香取」の表記は『万葉集』巻11の「香取の海」が最古。","八街市":"明治初期、幕府の放牧地だった小金牧・佐倉牧の開墾で、着手の順に初富・二和・三咲・豊四季・五香・六実・七栄と命名され、8番目が「八街」だった。","袖ケ浦市":"『古事記』によれば、日本武尊が走水を渡る際に大時化に遭い、妃の弟橘媛が海に身を投じて鎮めた。その袖が流れ着いたという伝説から、東京湾の千葉県側の海岸が「袖ヶ浦」と呼ばれた。","旭市":"1844年の「木曾義昌公250回忌」で京都の国学者野々口隆正が詠んだ追悼歌「信濃より いつる旭をしたひきて」から採ったとされる。木曾義昌は「旭将軍」木曾義仲の末裔とされ、この地で没した。","東金市":"最福寺境内の山嶺が鴇（とき）の頭に似ていることから「鴇ヶ峯」と称され、トウガネに転訛したと伝えられる。","銚子市":"利根川は川幅に比べて河口付近が非常に狭く、狭い河口から水が外洋へ注ぐ様が酒器の銚子から酒を注ぐ様子に似ていることから。古代は「三前郷」と呼ばれた。"}},"kyu":{"12101":{"t":1,"k":100,"r":[["@jisha",100]]},"12102":{"t":1,"k":145,"r":[["@bakufu",145]]},"12103":{"t":2,"k":974,"r":[["@bakufu",974]]},"12104":{"t":97,"k":36110,"r":[["@hatamoto",13597],["佐倉藩",10183],["生実藩",7355],["@bakufu",4401],["@other",574]],"p":1},"12202":{"t":40,"k":12640,"r":[["@hatamoto",5631],["高崎藩",5624],["@bakufu",848],["小見川藩",322],["@other",215]]},"12203":{"t":40,"k":14960,"r":[["@bakufu"