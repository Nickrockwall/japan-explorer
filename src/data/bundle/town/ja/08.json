12":[["常陸太田市",0,0],["水府村",0,2004],["里美村",0,2004],["金砂郷町",0,2004]],"08216":[["笠間市",0,0],["友部町",0,2006],["岩間町",0,2006]],"08217":[["取手市",0,0],["藤代町",0,2005]],"08220":[["つくば市",0,0],["茎崎町",0,2002]],"08223":[["潮来町",0,2001],["牛堀町",0,2001]],"08224":[["守谷町",0,2002]],"08225":[["大宮町",0,2004],["山方町",0,2004],["御前山村",0,2004],["緒川村",0,2004],["美和村",0,2004]],"08226":[["瓜連町",0,2005],["那珂町",0,2005]],"08227":[["下館市",0,2005],["協和町",0,2005],["明野町",0,2005],["関城町",0,2005]],"08228":[["岩井市",0,2005],["猿島町",0,2005]],"08229":[["新利根村",0,1996],["東村",0,1996],["桜川村",0,2005],["江戸崎町",0,2005]],"08230":[["出島村",0,1997],["千代田町",0,2005]],"08231":[["大和村",0,2005],["岩瀬町",0,2005],["真壁町",0,2005]],"08232":[["波崎町",0,2005],["神栖町",0,2005]],"08233":[["北浦村",0,1997],["玉造町",0,2005],["麻生町",0,2005]],"08234":[["大洋村",0,2005],["旭村",0,2005],["鉾田町",0,2005]],"08235":[["伊奈町",0,2006],["谷和原村",0,2006]],"08236":[["小川町",0,2006],["玉里村",0,2006],["美野里町",0,2006]],"08310":[["七会村",0,2005],["常北町",0,2005],["桂村",0,2005]],"08447":[["河内村",0,1996]],"08542":[["五霞村",0,1996]]},"yurai":{"8":{"水戸市":"古代から海や川の水の出入口は「みと」「みなと」と呼ばれ、那珂川と千波湖の間に突き出た台地の先端が「みと」と呼ばれた。「水戸」の表記は吉田薬王院文書（1400年ごろ）が早い例とされる。","つくば市":"筑波山にちなむ。当時の県知事竹内藤男が、漢字では「筑」を「ちく」と誤読されるおそれがあり、ひらがなの方が現代的だとして「つくば市」を推した。県内初のひらがな市名。","日立市":"行政名としての「日立」の初出は、1889年に宮田村と滑川村が合併した「日立村」。徳川光圀由来説もあるが、市の歴史編纂では佐藤敬忠の影響が大きいとされる。1939年の市制では日立グループの知名度も命名理由の一つになった。","ひたちなか市":"旧国名「常陸」の中心に位置し、那珂郡に属していたことにちなむ。勝田市と那珂湊市の合併では「常陸那珂市」「勝田湊市」なども候補に挙がったが、県内2番目のひらがな市名に落ち着いた。","土浦市":"土浦村（現在の美浦村）の名を借りた説、土屋藩の「土」と「浦」の合成説、「津々浦々」の転訛説などがある。","筑西市":"「筑波山の西」の意。最終候補には「北つくば市」もあり、4市町の頭文字を並べた「しあわせ市」も有力候補だった。","牛久市":"諸説あるが古語に由来すると考えられる。龍ケ崎市の金龍寺に伝わる、怠け者の小僧が牛になって沼に身を投げ「牛食う沼」が「牛久沼」になったという昔話が真説のように流布している。「潮来（うしおく）」説、「鵜宿」説などもある。","龍ケ崎市":"地頭の下河辺政義が源義経の姻戚であったことから所領を没収され、のちに龍崎と称したことに由来するとされる。竜巻が多かった説、龍が降ってきた地の先だった説などもある。","守谷市":"日本武尊が森を見て「森なる哉」と言った説、平将門が築城の際「守るに易き谷」と評した説（守谷城は後世の相馬氏の築城とみられる）、郡衙・屯倉があり「まもりびと」から転じた説の3つがあるが、正確には分からない。","坂東市":"「坂東」は本来、関東全体の古名で、足柄峠や碓氷峠を「坂」とし、その東の諸国を「坂の東」とした。関東のほぼ中央に位置することから2003年に選定。利根川の愛称「坂東太郎」にも由来する。","つくばみらい市":"市内全域が筑波郡だったことと、つくばエクスプレスの駅名「みらい平」による。地名や方角と関係のない「みらい」を市名に用いたのは前例がなく、日本一文字数の多い（6文字）市名の一つ。"}},"kyu":{"08201":{"t":76,"k":48324,"r":[["水戸藩",36784],["@hatamoto",4639],["常陸宍戸藩",3742],["@jisha",1358],["@other",1801]]},"08202":{"t":36,"k":25878,"r":[["水戸藩",25419],["@jisha",439],["@hatamoto",20]]},"08203":{"t":49,"k":28378,"r":[["土浦藩",27538],["@bakufu",471],["@hatamoto",353],["@jisha",17]]},"08204":{"t":58,"k":27219,"r":[["@bakufu",11156],["古河藩",9411],["壬生藩",2425],["関宿藩",2051],["@other",2176]]},"08205":{"t":64,"k":45002,"r":[["@hatamoto",21771],["常陸府中藩",7251],["牛久藩",5851],["@bakufu",5731],["@other",4398]]},"08207":{"t":32,"k":23998,"r":[["結城藩",10810],["壬生藩",5350],["@bakufu",3502],["一橋家領",2625],["@other",1711]]},"08208":{"t":31,"k":19761,"r":[["@hatamoto",11496],["前橋藩",4283],["仙台藩",2214],["牛久藩",1195],["@other",573]]},"08210":{"t":82,"k":38686,"r":[["@hatamoto",20858],["@bakufu",9582],["下妻藩",2259],["淀藩",1973],["@other",4014]]},"08211":{"t":73,"k":43148,"r":[["@hatamoto",26238],["@bakufu",12010],["田安家領",2539],["@jisha",941],["@other",1420]]},"08212":{"t":88,"k":57513,"r":[["水戸藩",56119],["@jisha",1394]]},"08214":{"t":15,"k":8622,"r":[["常陸松岡藩",8443],["@jisha",138],["水戸藩",41]]},"08215":{"t":35,"k":20981,"r":[["常陸松岡藩",9317],["川越藩",6257],["@hatamoto",2817],["@bakufu",1713],["@other",877]]},"08216":{"t":66,"k":39017,"r":[["笠間藩",18436],["@hatamoto",6945],["土浦藩",5883],["常陸宍戸藩",5316],["@other",2437]]},"08217":{"t":48,"k":27755,"r":[["@hatamoto",14729],["土浦藩",3190],["高岡藩",2971],["田安家領",2620],["@other",4245]]},"08219":{"t":22,"k":7664,"r":[["関宿藩",3737],["牛久藩",2341],["@hatamoto",1130],["@bakufu",233],["@other",223]]},"08220":{"t":166,"k":75241,"r":[["@hatamoto",28239],["土浦藩",14021],["@bakufu",13728],["谷田部藩",12254],["@other",6999]]},"08221":{"t":24,"k":18680,"r":[["水戸藩",18549],["@jisha",131]]},"08222":{"t":50,"k":18729,"r":[["@hatamoto",14222],["@jisha",3099],["松川藩",1194],["@bakufu",214]]},"08223":{"t":17,"k":14632,"r":[["水戸藩",11638],["麻生藩",2036],["@bakufu",542],["@jisha",416]]},"08224":{"t":15,"k":64