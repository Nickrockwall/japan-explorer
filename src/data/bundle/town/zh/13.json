89]],"13209":[["堺村",0,1889],["忠生村",0,1889],["鹤川村",0,1889],["南村",0,1889]],"13210":[["小金井村",0,1889]],"13211":[["小平村",0,1889]],"13212":[["日野町",0,1893],["七生村",0,1889]],"13213":[["东村山村",0,1889]],"13214":[["国分寺村",0,1889]],"13215":[["谷保村",0,1889]],"13218":[["福生村",0,1889],["熊川村",0,1889]],"13219":[["狛江村",0,1889]],"13221":[["清濑村",0,1889]],"13222":[["久留米村",0,1889]],"13224":[["多摩村",0,1889]],"13225":[["稻城村",0,1889]],"13227":[["西多摩村",0,1889]],"13228":[["小宫村",0,1889],["五日市町",0,1889],["菅生村",0,1889],["草花村",0,1889],["増户村",0,1889],["户仓村",0,1889],["濑户冈村",0,1889],["原小宫村",0,1889],["东秋留村",0,1889],["西秋留村",0,1889]],"13229":[["保谷村",0,1889],["田无町",0,1889]],"13303":[["箱根ケ崎村",0,1889],["长冈村",0,1889],["石畑村",0,1889],["殿ケ谷村",0,1889]],"13305":[["大久野村",0,1889],["平井村",0,1889]],"13307":[["檜原村",0,1889]],"13308":[["氷川村",0,1889],["古里村",0,1889],["小河内村",0,1889]],"13361":[["冈田村",0,1908],["元村",0,1908],["泉津村",0,1908],["野増村",0,1908],["差木地村",0,1908],["波浮港村",0,1908]],"13401":[["三根村",0,1908],["大贺乡村",0,1908],["末吉村",0,1908],["樫立村",0,1908],["中之乡村",0,1908]]},"heisei":{"13229":[["保谷市",0,2001],["田无市",0,2001]]},"yurai":{"13":{"新宿区":"来自 1698 年在甲州街道新开的宿场「内藤新宿」，设在高远藩内藤家的下屋敷。","江東区":"位于隅田川以东，从「辰巳区」「东区」「永代区」等候选里选出。","大田区":"1947 年大森区与蒲田区合并，各取一字。","杉並区":"江户初期，成宗、田端两村的领主沿青梅街道种了一排杉树（杉並木）。","板橋区":"来自旧中山道跨石神井川的一座「板桥」。","練馬区":"诸说：练马城；揉关东红土的「ねり場」；奈良时代的驿站「乗潴（のりぬま）」转音等。","足立区":"来自大化改新后设立的「武藏国足立郡」。","葛飾区":"「葛饰」本是下总国葛饰郡一大片地方的总称，《万叶集》里就有；今葛饰区一带近世叫「葛西」。","江戸川区":"来自区东侧的江户川。原本按区役所所在地拟叫「松江区」，因松江名气不大而改。","八王子市":"来自八王子神社（八王子权现）与以它为名的八王子城。","町田市":"诸说：「町」是田的区划；「まち」与「いち（市）」相通，这里集市兴盛；祭市神的「祭り田」等。","北区":"王子区与泷野川区合并时，候选有「城北区」「飞鸟山区」「赤羽区」等，「飞鸟山区」呼声最高，但嫌难读，最后取了简单的方位名「北区」。","豊島区":"北丰岛郡的四个町并入东京市时取了郡名（郡名可追溯到古代武藏国丰岛郡）。东京市最初的方案是「池袋区」，后改「目白区」，经各方陈情才定为「丰岛区」。","墨田区":"取隅田川堤岸的俗称「墨堤」的「墨」，加上隅田川的「田」。当时最多人推「隅田区」，但「隅」字不在当用汉字里，没能用上。","府中市":"律令时代武藏国的国府设在这里，「府中」即国府所在地。","港区":"候选从「爱宕区」「青山区」等收窄到「城南区」与「东港区」；「东港区」取的是区内的东京港，但「东京都东港区」读起来音重，于是去掉「东」字成了「港区」。","調布市":"古代租庸调里的「调」是缴纳当地特产，这里交的是布，故名「调布」。","文京区":"小石川区与本乡区合并时取的吉祥名：「文京」简洁好写，又合「文教之府」的形象。候选还有「京北区」「春日区」「汤岛区」等。","荒川区":"取自荒川。1965 年依河川法以荒川放水路为荒川干流后，区内原来的荒川改称隅田川，区里已没有「荒川」流过，但区名没改。东京市最初的方案是用区役所所在地「三河岛」。","台東区":"下谷区与浅草区合并时争执不下（下谷提「上野区」，浅草提「东区」），最后按都知事的提议用了下谷区台东小学校已在用的「台东」：上野高台的「台」，加上其东边下町的「东」。","西東京市":"田无市与保谷市合并时公开征名，从「西东京市」「榉野市」「北多摩市」「云雀市」「绿野市」五个候选中，经市民意向调查选了支持最多的「西东京市」。","小平市":"1889 年七村合并时，取当时中心小川村的「小」，和武藏野台地上平坦之地的「平」。","日野市":"诸说不定。《武藏名胜图会》说府中国府的烽火台设在这里，称「飞火野」，后改「日野」；《新编武藏风土记稿》记有西党之祖日奉宗頼祭祀日野宫权现的传说。","立川市":"两说：国府时代从府中看，多摩川在「多摩横山」前南北纵流，那一带称「立之河」，转为「立川」；或豪族立川氏在今普济寺筑城。","中央区":"位于东京市的地理中央，又是经济文化中心而得名，是日本第一个正式以「中央」为名的地方。候选还有「江户区」「银座区」「大江户区」。","東村山市":"这里是武藏七党之一村山党的根据地「武藏国村山」（狭山丘陵南麓）的最东端，所以冠以「东」字。「村山」来自把狭山丘陵称作「群山（むれやま）」。","青梅市":"诸说中最有名的是「将门誓梅」：平将门到金刚寺，把当马鞭的梅枝插地起誓，梅枝生根结果，果实却过了夏天仍青而不落。","小金井市":"两说：崖线（はけ）南侧叫「金井原」，读成「こがねいはら」；或崖下涌泉丰沛、价比黄金，称「黄金之井」。","東久留米市":"一般认为来自流经市北的黑目川旧称「久留米川」。成市时福冈县已有久留米市，为免混淆，又因车站名「东久留米」已为人熟悉，定为「东久留米市」。","狛江市":"来自古地名「狛江乡」（来历有几种说法）。成市时问卷 73.5% 的人主张保留「狛江」，也有人建议改成平假名的「こまえ市」。","あきる野市":"古来有「秋留」「阿伎留」的地名，旧五日市町又有阿伎留神社，于是取其音、写成平假名。秋川市想用「あきる野」或「阿伎留」，五日市町主张「秋川五日市市」，1995 年最后五日市町让步。","清瀬市":"诸说：从市内地名「清户」与柳濑川各取一字（「清户」传说是日本武尊在树下休息时称赞「清净之土」）；或取柳濑川「清澈的浅滩」之意。","国立市":"中央线国分寺站与立川站之间新开的车站与这一带，各取两站一字，叫「国立（くにたち）」。常被误读成「こくりつ（国立）」，所以有时写平假名。"}},"kyu":{"13101":{"t":1,"k":5,"r":[["@jisha",5]]},"13103":{"t":16,"k":2096,"r":[["@bakufu",2021],["@jisha",75]]},"13104":{"t":23,"k":3580,"r":[["@hatamoto",1300],["@bakufu",1225],["@jisha",1056]]},"13105":{"t":5,"k":369,"r":[["@jisha",232],["@bakufu",113],["@hatamoto",24]]},"13106":{"t":31,"k":2081,"r":[["@bakufu",1087],["@jisha",995]]},"13107":{"t":12,"k":3664,"r":[["@bakufu",3311],["@jisha",353]]},"13108":{"t":28,"k":6271,"r":[["@bakufu",5956],["一桥家领",244],["@jisha",72]]},"13109":{"t":13,"k":5466,"r":[["@bakufu",5331],["@jisha",134],["@other",1]]},"13110":{"t":6,"k":2564,"r":[["@bakufu",1246],["@jisha",1050],["@hatamoto",268]]},"13111":{"t":49,"k":17655,"r":[["@bakufu",12166],["@jisha",4064],["@hatamoto",1425]]},"13112":{"t":43,"k":10582,"r":[["@bakufu",5582],["彦根藩",2211],["@hatamoto",1989],["@jisha",800]]},"13113":{"t":19,"k":3003,"r":[["@bakufu",1530],["@jisha",915]