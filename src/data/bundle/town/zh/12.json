["三芳村",0,2006],["丸山町",0,2006],["千仓町",0,2006],["和田町",0,2006],["富山町",0,2006],["富浦町",0,2006],["白滨町",0,2006]],"12235":[["八日市场市",0,2006],["野荣町",0,2006]],"12236":[["佐原市",0,2006],["小见川町",0,2006],["山田町",0,2006],["栗源町",0,2006]],"12237":[["山武町",0,2006],["成东町",0,2006],["松尾町",0,2006],["莲沼村",0,2006]],"12238":[["大原町",0,2005],["夷隅町",0,2005],["岬町",0,2005]],"12239":[["大网白里町",0,2013]],"12410":[["光町",0,2006],["横芝町",0,2006]]},"yurai":{"12":{"船橋市":"传说日本武尊东征时在海老川上把船排起来铺板过河，这种船搭的桥就叫「船桥」，是最有力的说法。","松戸市":"诸说：养马盛行的「马里」转音；日本武尊在此「等待」随从的「待つ里」；或江户川渡口等船的「待つ里」。","流山市":"传说群马县赤城山崩下的一大块山体，顺利根川漂流到这里，故名「流山」。","浦安市":"首任浦安村长新井甚佐卫门说「愿海边安宁」（浦やすかれ），也含心安之意。《日本书纪·神武纪》里伊奘诺尊称日本为「浦安之国」，「浦安」也是日本的古雅美称。","野田市":"有力说法是武将野田右马助在此筑馆；但也有反过来说他是取地名自称野田的，说不准。","木更津市":"通说来自倭建命传说里的「君不去（きみさらず）」；另有「如月之津」等说。最早的写法是 1353 年文献里的「木佐良津」。","成田市":"诸说：雷多的「鸣田」，稻好的「熟田（なりた）」，近来的研究说是开垦谋生的「业田」。","四街道市":"车站西边的「四街道十字路」立着刻有成田山道、千叶町道、东金道、东京船桥道的道标，道路伸向四方，「四角」→「四之街道」→「四街道」。1881 年这里开私设邮局，首任局长福岛和吉向县里请求以「四街道」为局名，从此定名。","茂原市":"774 年赴任的贵族藤原黑麻吕在此开垦庄园「藻原庄」。湿地多，故称「藻原」，江户时改写成「茂原」。","香取市":"「かとり」的语源有「梶取（舵手）」「神鸟」「鹿取」等说。「香取」二字最早见于《万叶集》卷十一的「香取海」。","八街市":"明治初年开垦幕府牧场小金牧、佐仓牧，按开垦顺序给新村编号命名：初富、二和、三咲、丰四季、五香、六实、七荣，第八个就是「八街」。","袖ケ浦市":"《古事记》载，日本武尊渡走水时遇风暴，妃子弟橘媛投海平息海神之怒；她的衣袖漂到东京湾千叶一侧的海岸，于是这一带有了「袖之浦」的雅称。","旭市":"一说取自 1844 年木曾义昌 250 回忌上京都国学者野野口隆正的追悼歌「信浓出旭……」——「旭将军」木曾义仲的后裔义昌死在此地。","東金市":"来自「鸨之根」：最福寺境内山岭像朱鹮（とき）的头，称「鸨之峰」，转音为「とうがね」。","銚子市":"利根川河口宽阔的河面在入海处骤然变窄，像带嘴的酒器「铫子」往外倒酒，地名由此而来。古代这里叫「三前乡」。"}},"kyu":{"12101":{"t":1,"k":100,"r":[["@jisha",100]]},"12102":{"t":1,"k":145,"r":[["@bakufu",145]]},"12103":{"t":2,"k":974,"r":[["@bakufu",974]]},"12104":{"t":97,"k":36110,"r":[["@hatamoto",13597],["佐仓藩",10183],["生实藩",7355],["@bakufu",4401],["@other",574]],"p":1},"12202":{"t":40,"k":12640,"r":[["@hatamoto",5631],["高崎藩",5624],["@bakufu",848],["小见川藩",322],["@other",215]]},"12203":{"t":40,"k":14960,"r":[["@bakufu",11852],["@hatamoto",1552],["田中藩",1157],["@jisha",399]]},"12204":{"t":42,"k":14246,"r":[["@bakufu",11177],["@hatamoto",2995],["@jisha",75]]},"12205":{"t":92,"k":24823,"r":[["@bakufu",8