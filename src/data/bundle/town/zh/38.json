",0,2004]]},"yurai":{"38":{"松山市":"1603 年加藤嘉明筑城，城地取名「松山」。为什么用「松」有两说：城山上种着许多松树；或取德川一门松平家的「松」字（江户时代《予阳郡乡俚谚集》）。","新居浜市":"奈良末期神野郡的郡家移到今新居浜市中村一带；平安初神野郡改称新居郡，靠海的北部后来叫「新居滨」。","西条市":"镰仓时代的庄园名里已有「西条」，后为西条藩所承袭；《予章记》记河野通信因军功受赐「新居西条之乡」。2003 年合并公开征名，「西条市」占有效件数 65%，胜过「石鎚市」等候选。"}},"kyu":{"38201":{"t":191,"k":83648,"r":[["伊予松山藩",82400],["大洲藩",628],["@bakufu",619],["@other",1]]},"38202":{"t":127,"k":60748,"r":[["今治藩",34627],["伊予松山藩",21488],["@bakufu",4633]]},"38203":{"t":75,"k":26096,"r":[["宇和岛藩",13788],["伊予吉田藩",12309]]},"38204":{"t":26,"k":12664,"r":[["宇和岛藩",12238],["伊予吉田藩",425],["@other",1]]},"38205":{"t":22,"k":16033,"r":[["西条藩",12135],["@bakufu",2084],["小松藩",1814]]},"38206":{"t":95,"k":58126,"r":[["伊予松山藩",22362],["西条藩",22033],["小松藩",11036],["@bakufu",2695]]},"38207":{"t":65,"k":26881,"r":[["大洲藩",22993],["新谷藩",2168],["宇和岛藩",1720]]},"38210":{"t":29,"k":17288,"r":[["大洲藩",15927],["新谷藩",1361]]},"38213":{"t":55,"k":22325,"r":[["西条藩",7957],["@bakufu",7544],["今治藩",6824]]},"38214":{"t":83,"k":33903,"r":[["宇和岛藩",31149],["伊予吉田藩",2177],["大洲藩",577]]},"38215":{"t":21,"k":13834,"r":[["伊予松山藩",13834]]},"38356":{"t":6,"k":2629,"r":[["今治藩",1341],["伊予松山藩",1289]]},"38386":{"t":23,"k":7705,"r":[["伊予松山藩",6557],["大洲藩",1148]]},"38401":{"t":18,"k":11875,"r":[["伊予松山藩",11541],["大洲藩",334]]},"38402":{"t":21,"k":4393,"r":[["大洲藩",3018],["新谷藩",1375]]},"38422":{"t":36,"k":11236,"r":[["大洲藩",10388],["新谷藩",848]]},"38442":{"t":6,"k":4764,"r":[["宇和岛藩",4764]]},"38484":{"t":9,"k":3123,"r":[["宇和岛藩",1982],["伊予吉田藩",1141]]},"38488":{"t":34,"k":9297,"r":[["伊予吉田藩",5917],["宇和岛藩",3380]]},"38506":{"t":17,"k":7838,"r":[["宇和岛藩",7838]]}},"famous":{"38201":[["Q315152","正冈子规",1867,1902,"正岡子規"],["Q743767","高滨虚子",1874,1959,"高浜虚子"],["Q709211","秋山真之",1868,1918,"秋山真之"],["Q1056232","一遍",1239,1289,"一遍"],["Q419492","秋山好古",1859,1930,"秋山好古"],["Q1071677","白川义则",1869,1932,"白川義則"]],"38202":[["Q7674337","矢内原忠雄",1893,1961,"矢内原忠雄"],["Q7046224","片上伸",1884,1928,"片上伸"],["Q11098611","村上武吉",1533,1604,"村上武吉"]],"38203":[["Q171601","伊藤大辅",1898,1981,"伊藤大輔 (映