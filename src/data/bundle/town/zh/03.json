":[["盛冈市",0,0],["玉山村",0,2006]],"03202":[["宫古市",0,0],["新里村",0,2005],["田老町",0,2005],["川井村",0,2010]],"03203":[["大船渡市",0,0],["三陆町",0,2001]],"03205":[["花巻市",0,0],["大迫町",0,2006],["东和町",0,2006],["石鸟谷町",0,2006]],"03207":[["久慈市",0,0],["山形村",0,2006]],"03208":[["远野市",0,0],["宫守村",0,2005]],"03209":[["一关市",0,0],["千厩町",0,2005],["大东町",0,2005],["室根村",0,2005],["川崎村",0,2005],["东山町",0,2005],["花泉町",0,2005],["藤泽町",0,2011]],"03213":[["二户市",0,0],["浄法寺町",0,2006]],"03214":[["安代町",0,2002],["松尾村",0,2005],["西根町",0,2005]],"03215":[["前泽町",0,2006],["水泽市",0,2006],["江刺市",0,2006],["胆泽町",0,2006],["衣川村",0,2006]],"03216":[["泷泽村",0,2014]],"03366":[["泽内村",0,2005],["汤田町",0,2005]],"03507":[["大野村",0,2006],["种市町",0,2006]]},"yurai":{"3":{"盛岡市":"古称「不来方」「古志方」，起初叫「森之冈（森ヶ岡）」，后来叫「森冈」；藩主南部氏取「兴盛繁荣之冈」的意思写成「盛冈」。另一说是从「树林多的冈」转来。","宮古市":"诸说：一般认为是闭伊地方经济、文化中心的「都（みやこ）」；也有「有神社的地方（宫处）」、山中聚落「深山处」等说法。","大船渡市":"意思是「大的船码头」。","花巻市":"中世叫「鸟谷崎」。来历诸说：出产名马的牧场「花之牧」；北上川春天水面漂满花瓣；阿伊努语「パナ（下游的开阔地）」等。","北上市":"一般认为由古称「日高见（ひたかみ）」转来；今天的北上市是 1954 年黑泽尻町等七町村合并时命名的。","久慈市":"南北朝时代起就作为郡名出现。来历诸说：地形收窄（くびれ）；海蚀崩塌之处；河口的船码头「口津」等。","遠野市":"一说是闭伊更深处「远闭伊」的原野，一说是山间遥远的原野；也有阿伊努语「ト（沼）ヌプ（野）」等说法。","一関市":"一说来自「一之堰」——为挡北上川泛滥修的第一道堰；一说因市内有一关、二关、三关，与平泉的关所有关。","陸前高田市":"「陆前」是旧国名；「高田」一般认为来自气仙郡总镇守冰上山的神田。1955 年八町村合并时，以中心的高田町为名并冠上「陆前」。","釜石市":"诸说：这里多产做釜的石头；阿伊努语「晒鱼的地方」或「有平岩的地方」；形状像釜的石头等。","二戸市":"来自平安时代糠部郡的「九户四门」制：在围栅的木户上编号一到九，每户设一个牧场；这里是「二户」。今天的二户市是 1972 年合并设市时命名的。"}},"kyu":{"03201":{"t":59,"k":34773,"r":[["盛冈藩",34773]]},"03202":{"t":47,"k":8733,"r":[["盛冈藩",6951],["仙台藩",1782]]},"03203":{"t":10,"k":5604,"r":[["仙台藩",5604]]},"03205":{"t":100,"k":68325,"r":[["盛冈藩",68325]]},"03206":{"t":36,"k":40169,"r":[["盛冈藩",32211],["仙台藩",7958]]},"03207":{"t":28,"k":3872,"r":[["八户藩",3594],["盛冈藩",277],["@other",1]]},"03208":{"t":43,"k":14767,"r":[["盛冈藩",14767]]},"03209":{"t":78,"k":75861,"r":[["仙台藩",44529],["@bakufu",21832],["一关藩",9500]]},"03210":{"t":10,"k":7164,"r":[["仙台藩",7164]]},"03211":{"t":10,"k":1291,"r":[["盛冈藩",914],["仙台藩",377]]},"03213":{"t":42,"k":8991,"r":[["盛冈藩",8093],["斗南藩",898]]},"0321