,2006]]},"yurai":{"25":{"大津市":"近江大津宫废弃后，这里只被叫作「古津（旧都的港）」；794 年迁都平安京，大津成了京城的外港，「大津」之名随之恢复。","長浜市":"原称「今滨」，约 1575 年羽柴秀吉改名「长滨」。有说「长」取自其主君织田信长，但无从证实。","彦根市":"天照大神之子活津彦根命被奉祀在彦根山（后来筑彦根城的湖畔山），地名由此而来。","甲賀市":"「こうか」的读法来自古代统治此地的百济系豪族鹿深（かふか）氏。车站等公共设施读「こうか」，但姓氏和民间名称里读「こうが」的也不少。","守山市":"一说来自守护琵琶湖对岸比叡山的寺院东门院；一说来自附近都贺山的「山守」。","近江八幡市":"地名来自日牟礼八幡宫。1954 年成市时福冈县已有八幡市，于是冠上旧国名「近江」；后来福冈的八幡市并入北九州市，1977 年京都府的八幡市成立时就不必回避了——先成市的反而带了冠称。"}},"kyu":{"25201":{"t":140,"k":58742,"r":[["膳所藩",21377],["@bakufu",13353],["@jisha",12490],["佐野藩",6410],["@other",5112]]},"25202":{"t":111,"k":62405,"r":[["彦根藩",50546],["@bakufu",11715],["@jisha",144]]},"25203":{"t":282,"k":156092,"r":[["彦根藩",61112],["@bakufu",39371],["郡山藩",12195],["淀藩",10837],["@other",32577]]},"25204":{"t":101,"k":58913,"r":[["@bakufu",17255],["@hatamoto",13734],["郡山藩",12643],["川越藩",5922],["@other",9359]]},"25206":{"t":42,"k":29091,"r":[["膳所藩",17395],["@hatamoto",4113],["@bakufu",3229],["淀藩",1354],["@other",3000]]},"25207":{"t":53,"k":35109,"r":[["@hatamoto",10787],["淀藩",5736],["@bakufu",5493],["宫津藩",3386],["@other",9707]]},"25208":{"t":40,"k":21795,"r":[["膳所藩",6294],["@hatamoto",6260],["@bakufu",3753],["前桥藩",2103],["@other",3385]]},"25209":{"t":119,"k":66269,"r":[["@hatamoto",23079],["水口藩",19402],["@bakufu",9135],["山上藩",3068],["@other",11585]]},"25210":{"t":49,"k":34643,"r":[["@hatamoto",14398],["@bakufu",7611],["淀藩",2512],["三上藩",2363],["@other",7759]]},"25211":{"t":17,"k":11799,"r":[["淀藩",3248],["水口藩",2235],["@bakufu",1809],["@hatamoto",1752],["@other",2755]]},"25212":{"t":156,"k":74635,"r":[["郡山藩",18177],["大沟藩",17503],["@hatamoto",10864],["@bakufu",7144],["@other",20947]]},"25213":{"t":202,"k":110233,"r":[["@bakufu",59545],["@hatamoto",20988],["郡山藩",9693],["彦根藩",5793],["@other",14214]]},"25214":{"t":92,"k":43935,"r":[["彦根藩",25582],["郡山藩",4659],["近江宫川藩",3309],["@hatamoto",2990],["@other",7395]]},"25383":{"t":55,"k":30236,"r":[["@bakufu",8202],["川越藩",6758],["@hatamoto",5567],["仁正寺藩",3511],["@other",6198]]},"25384":{"t":12,"k":9866,"r":[["@b