12":[["常陆太田市",0,0],["水府村",0,2004],["里美村",0,2004],["金砂乡町",0,2004]],"08216":[["笠间市",0,0],["友部町",0,2006],["岩间町",0,2006]],"08217":[["取手市",0,0],["藤代町",0,2005]],"08220":[["つくば市",0,0],["茎崎町",0,2002]],"08223":[["潮来町",0,2001],["牛堀町",0,2001]],"08224":[["守谷町",0,2002]],"08225":[["大宫町",0,2004],["山方町",0,2004],["御前山村",0,2004],["緒川村",0,2004],["美和村",0,2004]],"08226":[["瓜连町",0,2005],["那珂町",0,2005]],"08227":[["下馆市",0,2005],["協和町",0,2005],["明野町",0,2005],["关城町",0,2005]],"08228":[["岩井市",0,2005],["猿岛町",0,2005]],"08229":[["新利根村",0,1996],["东村",0,1996],["桜川村",0,2005],["江户崎町",0,2005]],"08230":[["出岛村",0,1997],["千代田町",0,2005]],"08231":[["大和村",0,2005],["岩濑町",0,2005],["真壁町",0,2005]],"08232":[["波崎町",0,2005],["神栖町",0,2005]],"08233":[["北浦村",0,1997],["玉造町",0,2005],["麻生町",0,2005]],"08234":[["大洋村",0,2005],["旭村",0,2005],["鉾田町",0,2005]],"08235":[["伊奈町",0,2006],["谷和原村",0,2006]],"08236":[["小川町",0,2006],["玉里村",0,2006],["美野里町",0,2006]],"08310":[["七会村",0,2005],["常北町",0,2005],["桂村",0,2005]],"08447":[["河内村",0,1996]],"08542":[["五霞村",0,1996]]},"yurai":{"8":{"水戸市":"古时把海、河的出入口叫「みと」或「みなと」；那珂川与千波湖之间突出的台地前端被叫作「みと」。写成「水户」的最早例子见于 1400 年前后的吉田药王院文书。","つくば市":"取自筑波山。当时的县知事竹内藤男主张用平假名：写成「筑波」容易把「筑」误读成「ちく」，平假名也更简洁现代。这是茨城县第一个平假名市名。","日立市":"「日立」作为行政名最早是 1889 年宫田村与滑川村合并成的「日立村」。另有德川光圀命名的传说，但据市史研究，佐藤敬忠的影响更大。1939 年成市时，日立集团的知名度也是取名理由之一。","ひたちなか市":"位于旧国「常陆」中心，又曾属那珂郡，故名。胜田市与那珂凑市合并时还有「常陆那珂市」「胜田凑市」等方案，最后定为县内第二个平假名市名。","土浦市":"说法不一：借用土浦村（今属美浦村）的名字；土屋藩的「土」加「浦」；或由「津津浦浦」转来。","筑西市":"意为「筑波山之西」。最后的候选还有「北筑波市」，取四个旧市町头一个音拼成的「しあわせ市（幸福市）」也一度呼声很高。","牛久市":"诸说，多半来自古语。龙崎市金龙寺的故事——懒小僧变成牛跳进沼里，「牛食沼」成了「牛久沼」——流传得像定说。另有「潮来（うしおく）」「鹈宿」等说。","龍ケ崎市":"一般认为来自地头下河边政义：他因是源义经的姻亲被没收领地后改姓「龙崎」。另有龙卷风多、龙从天降之地的前端等说。","守谷市":"三说都不确定：日本武尊见森林惊叹「森なる哉」；平将门筑城时说这里是「易守之谷」（但守谷城其实是后来的相马氏所筑）；或郡衙、屯仓所在，「守护者」转音。","坂東市":"「坂东」本是关东全境的古称：以足柄岭、碓冰岭为「坂」，以东诸国为「坂之东」。市位于关东中央，2003 年选定；也取自利根川的爱称「坂东太郎」。","つくばみらい市":"全境原属筑波郡，加上筑波快线的站名「みらい平（未来平）」。用与地名方位无关的「未来」作市名前所未有，也是日本字数最多（6 字）的市名之一。"}},"kyu":{"08201":{"t":76,"k":48324,"r":[["水户藩",36784],["@hatamoto",4639],["常陆宍户藩",3742],["@jisha",1358],["@other",1801]]},